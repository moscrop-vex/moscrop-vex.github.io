---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideMenu from "../components/SideMenu.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const pageTitle = `${title} | ${site.shortName}`;
const pageUrl = canonical
  ? `${site.url}${canonical}`
  : Astro.url.href.replace(/\/$/, "");

import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/header.css";
import "../styles/footer.css";
---

<!DOCTYPE html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Iceland&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <SideMenu />

    <Header />

    <div class="content">
      <slot />
    </div>

    <Footer />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SportsTeam",
        "name": "Moscrop Robotics",
        "alternateName": "Mosbots",
        "url": "https://moscrop-vex.github.io",
        "description": "Mosbots is Moscrop Secondary's competitive VEX Robotics teams, designing and building robots to compete in the V5 Robotics Competition. Based in Burnaby, BC.",
        "location": {
          "@type": "Place",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Burnaby",
            "addressRegion": "BC",
            "addressCountry": "CA"
          }
        }
      }
    </script>
  </body>
</html>

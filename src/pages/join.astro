---
import "../styles/join.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { meetingRoom, meetingTimes, site } from "../data/site";
---

<BaseLayout
  title="Join Moscrop Robotics"
  description="Become a member of the V5RC 32987 Moscrop Robotics team and participate in robotics competitions"
  canonical="/join"
>
    <section class="join">
        <div class="join-content">
        <h1>Join Moscrop Robotics</h1>
        <p>
            Looking to join the team? We welcome students of all skill levels and backgrounds to participate in our robotics program. Whether you're a beginner or an experienced builder, there's a place for you on our team.
        </p>
        <p>
            To join, simply come to {meetingRoom} during one of our meeting times!
        </p>
        </div>

        <div class="join-meetings">
          <h2>When We Meet</h2>
          <ul class="join-meeting-list">
            {meetingTimes.map((time) => (
              <li>{time}</li>
            ))}
          </ul>
          <p class="join-meeting-room">All meetings are in {meetingRoom}</p>
        </div>

        <div class="join-discord">
          <h2>Join Our Discord</h2>
          <p>
            Ask questions, get meeting updates, and chat with the team on our
            Discord server.
          </p>
          <a
            href={site.social.discord}
            class="join-discord-btn"
            target="_blank"
            rel="noopener noreferrer"
          >Join the Discord</a>
        </div>
  </section>
</BaseLayout>

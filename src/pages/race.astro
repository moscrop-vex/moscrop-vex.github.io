---
import "../styles/race.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { race } from "../data/race";
---

<BaseLayout
  title="Robo Race"
  description="The Moscrop Robotics Robo Race: a build-the-fastest-robot race for grades 8 and 9, running on the Wemos R1 D1 (ESP8266) over WiFi"
  canonical="/race"
>
  <section class="race">
    <h2>{race.title}</h2>
    <span class="race-audience">{race.audience}</span>
    <p class="race-lede">{race.summary}</p>

    <div class="race-grid">
      <div class="race-card">
        <h3>The Challenge</h3>
        <p>
          The goal is to build the fastest robot possible. The robots take turns going around a course, and the robot with the fastest time wins. Pretty simple.
        </p>
      </div>

      <div class="race-card">
        <h3>The Electronics</h3>
        <p>{race.electronics.description}</p>
        <div class="race-specs">
          <div class="race-spec">
            <strong>{race.electronics.board}</strong>
            <span>Board</span>
          </div>
          <div class="race-spec">
            <strong>{race.electronics.chip}</strong>
            <span>Chip &amp; WiFi</span>
          </div>
        </div>
      </div>

      <div class="race-card race-card--wide">
        <h3>Rules</h3>
        <ul class="race-rules">
          {race.rules.map((rule) => (
            <li>
              <span class="rule-label">{rule.label}</span>
            </li>
          ))}
        </ul>
        <p class="race-note">
          If it isn't listed here, it's allowed. Measurements are taken at the largest point of
          the robot.
        </p>
      </div>

      <div class="race-card">
        <h3>Teams</h3>
        <p>{race.teams.description}</p>
        <div class="race-specs">
          <div class="race-spec">
            <strong>{race.teams.size}</strong>
            <span>Group size</span>
          </div>
        </div>
      </div>

      <div class="race-card">
        <h3>Need help?</h3>
        <p>
          If you are stuck and/or need help, ask one of our senior team members for help. We are happy to help you get your robot working and moving.
        </p>
      </div>
    </div>

    <div class="race-cta">
      <p>
        Interested? Come find us in Rm 120 during any of our meeting times and ask about the
        Robo Race.
      </p>
      <a href="/join" class="btn">How to Join</a>
    </div>
  </section>
</BaseLayout>

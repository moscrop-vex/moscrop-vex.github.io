---
import "../styles/competitions.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import CompetitionEntry from "../components/CompetitionEntry.astro";
import { competitions } from "../data/competitions";

const wltTotals = competitions
  .flatMap((competition) => competition.results)
  .reduce(
    (totals, { wlt }) => {
      const [wins, losses, ties] = wlt.split("-").map(Number);
      totals.wins += wins;
      totals.losses += losses;
      totals.ties += ties;
      return totals;
    },
    { wins: 0, losses: 0, ties: 0 },
  );
const totalGames = wltTotals.wins + wltTotals.losses + wltTotals.ties;
const averageWinRate =
  totalGames > 0 ? Math.round((wltTotals.wins / totalGames) * 100) : 0;
---

<BaseLayout
  title="Moscrop Robitcs Competitions"
  description="Learn about the competitions that the V5RC 32987 Moscrop Robotics teams participate in"
  canonical="/comp"
>
  <section class="competitions">
    <h2>Competition History</h2>
    <p>Below is a running log of our team's event results.</p>

    <div class="timeline">
      <div class="timeline-line"></div>
      {competitions.map((comp, i) => <CompetitionEntry result={comp} index={i} />)}
    </div>

    <div class="season-summary">
      <div class="season-stat">
        <span class="stat-number">{competitions.length}</span>
        <span class="stat-label">Total Events</span>
      </div>
      <div class="season-stat">
        <span class="stat-number">{averageWinRate}%</span>
        <span class="stat-label">Average Win Rate</span>
      </div>
    </div>
  </section>
</BaseLayout>

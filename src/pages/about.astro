---
import "../styles/hero.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout
  title="About Moscrop Robotics"
  description="All about the V5RC 32987 Moscrop Robotics teams"
  canonical="/about"
>
  <Hero image="/img/about-hero-bg.jpg" variant="about" showShapes={false}>
    <h2>About Mosbots</h2>
  </Hero>

  <style>
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
      margin-bottom: var(--space-xl);
    }

    @media (max-width: 640px) {
      .about-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <section style="max-width: 900px; margin: 0 auto; padding: var(--space-3xl) var(--space-xl);">
    <div class="about-grid">
      <div style="background: var(--gradient-card); border: 1px solid var(--clr-border-subtle); border-radius: var(--radius-lg); padding: var(--space-xl);">
        <h3 style="font-family: var(--font-display); font-size: var(--text-xl); color: var(--clr-accent); margin: 0 0 var(--space-md);">Who We Are</h3>
        <p style="font-family: var(--font-body); font-size: var(--text-base); color: var(--clr-text-secondary); margin: 0; line-height: 1.6;">
          Mosbots is a student-run robotics club at Moscrop Secondary School in Burnaby, B.C. Every year, our 2 VEX V5 teams build robots to compete in various competitions. Our club is open to all students, regardless of experience or skill level.
        </p>
      </div>

      <div style="background: var(--gradient-card); border: 1px solid var(--clr-border-subtle); border-radius: var(--radius-lg); padding: var(--space-xl);">
        <h3 style="font-family: var(--font-display); font-size: var(--text-xl); color: var(--clr-accent); margin: 0 0 var(--space-md);">What We Do</h3>
        <p style="font-family: var(--font-body); font-size: var(--text-base); color: var(--clr-text-secondary); margin: 0; line-height: 1.6;">
          We run two competitive VEX V5 teams, 32987A and 32987B, as well as a group of younnger students participating in our Robo Race competition. We design, build, and program our robots from scratch each year, and compete in local and regional competitions.
        </p>
      </div>
    </div>
    <div style="background: var(--gradient-card); border: 1px solid var(--clr-border-subtle); border-radius: var(--radius-lg); padding: var(--space-xl); margin-bottom: var(--space-2xl);">
      <h3 style="font-family: var(--font-display); font-size: var(--text-xl); color: var(--clr-accent); margin: 0 0 var(--space-md);">What is VEX V5</h3>
      <p style="font-family: var(--font-body); font-size: var(--text-base); color: var(--clr-text-secondary); margin: 0; line-height: 1.6;">
        VEX V5 is a robotics competition platform where students design, build, and program robots to compete in a new game each year. Teams compete in local, regional, and national competitions, and the top teams can qualify for the VEX Robotics World Championship.
      </p>
    </div>

    <div style="background: var(--gradient-card); border: 1px solid var(--clr-border-subtle); border-radius: var(--radius-lg); padding: var(--space-xl); margin-bottom: var(--space-2xl);">
      <h3 style="font-family: var(--font-display); font-size: var(--text-xl); color: var(--clr-accent); margin: 0 0 var(--space-md);">For beginners</h3>
      <p style="font-family: var(--font-body); font-size: var(--text-base); color: var(--clr-text-secondary); margin: 0; line-height: 1.6;">
        If you're new to robotics, don't worry! We are hosting a beginner friendly competition this year called Robo Race! We provide the program and parts, you build the robot and modify the program to try make the fastest robot possible. Find out more information on our <a href="/race" style="color: var(--clr-accent); text-decoration: underline;">Robo Race</a> page.
      </p>
    </div>
  </section>
</BaseLayout>

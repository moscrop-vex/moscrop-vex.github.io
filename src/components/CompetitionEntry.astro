---
import type { CompetitionResult } from "../data/competitions";

interface Props {
  result: CompetitionResult;
  index: number;
}

const { result, index } = Astro.props;
const dateObj = new Date(result.date);
const formattedDate = dateObj.toLocaleDateString("en-CA", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<div class="timeline-entry">
  <div class="timeline-dot"></div>
  <div class="timeline-content">
    <h3 class="event-name">{result.event}</h3>
    <time datetime={result.date}>{formattedDate}</time>

    <div class="results-list">
      {result.results.map((r) => (
        <div class="result-card">
          <span class="team-badge">{r.team}</span>
          <span class="placement"
            >{r.placement.split("/")[0]}<small>/{r.placement.split("/")[1]}</small></span
          >
          <div class="wlt-bar">
            <div
              class="wlt-fill"
              style={`--win-pct: ${(() => {
                const [w] = r.wlt.split("-").map(Number);
                const total = r.wlt.split("-").map(Number).reduce((a, b) => a + b, 0);
                return total > 0 ? Math.round((w / total) * 100) : 0;
              })()}%`}
            ></div>
          </div>
          <span class="awards-badge">{r.awards !== "None" ? r.awards : ""}</span>
        </div>
      ))}
    </div>
  </div>
</div>
